# Backend origin from FRONTEND_SPEC.md:
# HTTP: http://localhost:5067
# HTTPS: https://localhost:7143
#
# This frontend's Axios client appends service paths to VITE_API_BASE_URL,
# so keep the /api prefix here.
VITE_API_BASE_URL=http://localhost:5067/api

# Useful local development URLs.
VITE_API_SWAGGER_URL=http://localhost:5067/swagger
VITE_API_HEALTH_URL=http://localhost:5067/ping
